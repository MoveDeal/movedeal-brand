0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg></div></div><h3 class="text-xl font-semibold mb-2">Move with Confidence</h3><p class="text-gray-600">Enjoy a stress-free move with our support throughout</p></div></div></div></section><section class="py-20 bg-white"><div class="container mx-auto px-4"><div class="text-center mb-16" style="opacity:0;transform:translateY(20px)"><h2 class="text-3xl md:text-4xl font-bold text-dark-gray mb-4">What Our Customers Say</h2><div class="w-20 h-1 bg-primary mx-auto"></div></div><div class="relative"><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><div class="bg-background rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow" style="opacity:0;transform:translateY(20px)"><div class="flex items-center mb-4"><div class="relative w-12 h-12 rounded-full overflow-hidden mr-4"><img alt="Emma Schmidt" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/placeholder.svg?height=200&amp;width=200"/></div><div><h3 class="font-semibold">Emma Schmidt</h3><p class="text-sm text-gray-500">Berlin Movers GmbH</p></div></div><div class="flex mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4 w-4 text-yellow-400 fill-yellow-400"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"